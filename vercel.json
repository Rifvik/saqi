{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"const fs=require('fs'),p=require('path');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});for(const f of['index.html','styles.css','sw.js','manifest.json','icon.svg','js','vendor'])fs.cpSync(f,p.join('dist',f),{recursive:true});\"",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 120,
      "excludeFiles": "{dist/**,js/**,vendor/**,tests/**,__pycache__/**,*.bat,*.sh,*.md,styles.css,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|js/|vendor/|tests/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
