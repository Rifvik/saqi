{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf dist && mkdir -p dist && cp -R index.html styles.css sw.js manifest.json icon.svg js vendor dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 120,
      "excludeFiles": "{dist/**,js/**,vendor/**,tests/**,__pycache__/**,*.bat,*.sh,*.md,styles.css,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|js/|vendor/|tests/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
