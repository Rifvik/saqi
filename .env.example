# Local dev: copy to .env (never commit .env). server.py loads it automatically.
# Vercel: add these same keys under Project Settings -> Environment Variables.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: any Gemini Flash model id
GEMINI_MODEL=gemini-3.8-flash
# Optional: deterministic demo replies without a Gemini key (for UI preview only)
# SAQI_AI_MOCK=1
